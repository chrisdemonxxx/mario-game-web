{
  "name": "mario-game-web",
  "version": "0.1.0",
  "description": "A Mario-like web-based platformer game",
  "main": "src/game.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "jest --coverage",
    "lint": "eslint src tests server.js",
    "lint:fix": "eslint src tests server.js --fix",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run lint && npm test && npm run test:e2e",
    "test:e2e": "vitest"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer": "^25.17.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "puppeteer@25.17.0": true
  }
}
