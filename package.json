{
  "name": "mario-game-web",
  "version": "0.1.0",
  "description": "A Mario-like web-based platformer game",
  "main": "src/game.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "test": "jest --coverage --passWithNoTests",
    "lint": "eslint src tests server.js",
    "lint:fix": "eslint src tests server.js --fix",
    "audit": "npm audit --audit-level=high",
    "ci": "npm run lint && npm test"
  },
  "devDependencies": {
    "eslint": "_8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
